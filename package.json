{
  "name": "roiheimen",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "build": "cd pkg/web; yarn build",
    "setup": "cd pkg/server; yarn setup",
    "lint": "cd pkg/web && yarn lint",
    "start:web": "cd pkg/web; yarn start",
    "start:server": "cd pkg/server; yarn start",
    "start": "run-p start:server start:web",
    "test:e2e": "cd e2e && npx playwright test",
    "test:e2e:ui": "cd e2e && npx playwright test --ui",
    "test:e2e:debug": "cd e2e && DEBUG=1 npx playwright test"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "prettier": "^2.1.2"
  }
}
